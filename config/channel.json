{
  "channel": "Object-Talk",
  "language": "de",
  "content_pillars": [
    "Ernaehrung",
    "Gesundheit",
    "menschlicher Koerper",
    "Biologie",
    "Zellen",
    "Gehirn und Nervensystem",
    "Verdauung",
