{
  "channel": "Object-Talk",
  "language": "de",
  "content_pillars": [
    "Ernaehrung",
    "Gesundheit",
    "menschlicher Koerper",
    "Biologie",
    "Zellen",
    "Gehirn und Nervensystem",
    "Verdauung",
    "Blut und Kreislauf",
    "Immunsystem",
    "Stoffwechsel",
    "Schlaf",
    "Hormone",
    "Vitamine und Mineralstoffe"
  ],
  "audience": "familienfreundlich, leicht verstaendlich, besonders fuer juengere Zuschauer geeignet, aber nicht babyhaft",
  "script": {
    "opening_style": "curiosity-first",
    "opening_seconds_target": "0-10",
    "preferred_hook_patterns": [
      "direct-question",
      "surprising-statement",
      "myth-correction",
      "everyday-mystery",
      "contrast"
    ],
    "preferred_direct_question_pattern": "Hast du dich schon mal gefragt, warum ...?",
    "require_hook_in_first_sentence": true,
    "require_surprising_answer_or_contrast_immediately_after_hook": true,
    "require_clear_viewer_payoff_within_first_15_seconds": true,
    "avoid_schoolbook_openings": true,
    "style": "spoken, active, concise, concrete, curiosity-driven, no textbook prose"
  },
  "visual_identity": {
    "status": "APPROVED_2026-09-27",
    "approved_channel_style": "Clean Animated Biology Illustration",
    "canonical_spec": "bildwelt/BIOLOGY-ILLUSTRATION-WORLD.md",
    "flow_style_block": "bildwelt/FLOW-STYLE-BLOCK.txt",
    "approved_explainer_style": "clean animated biology illustration",
    "anatomy": "simplified but recognizable",
    "shape_language": "smooth organic illustrated forms with clean outlines",
    "depth": "soft gradients, subtle shadows, light dimensional depth, never CGI-like",
    "backgrounds": "bright calm pale backgrounds, not empty white studio space",
    "color_system": "clear biological colors chosen for readability; flexible by topic",
    "labels": "1-3 short German labels with clean pointer lines when useful",
    "complexity": "low; 2-5 central visible elements and one dominant process per frame",
    "style_reference_image": null,
    "written_spec_is_authoritative": true,
    "final_image_generation_allowed": true,
    "historical_pilot_styles_are_authoritative": false,
    "forbidden_historical_styles": [
      "2.5D Soft-3D",
      "premium feature-animation 3D",
      "medical CGI",
      "glossy plastic 3D",
      "historical pilot visual worlds"
    ]
  },
  "flow_prompting": {
    "instruction_language": "en",
    "visible_text_language": "de",
    "generate_each_image_individually": true,
    "duplicate_image_reuse_allowed": false,
    "scene_difference_minimum_dimensions_changed": 2,
    "prefer_process_relationship_before_after_context_over_repeated_portraits": true,
    "prompt_style": "short stable style block plus scene plus process plus labels plus short negative rule",
    "style_block_path": "bildwelt/FLOW-STYLE-BLOCK.txt",
    "labels_generated_in_flow": true,
    "preferred_labels_per_image": "1-3",
    "avoid_overcomplicated_prompts": true
  },
  "labels": {
    "language": "de",
    "source": "02_bildprompts/label-plan.json",
    "preferred_per_image": "1-3",
    "max_per_image_guideline": 3,
    "avoid_overload": true,
    "final_rendering_strategy": "GOOGLE_FLOW_DIRECT_FOR_BIOLOGY_LABELS"
  },
  "audio_pacing": {
    "default_voice_speed_multiplier": 1.10,
    "compress_long_tts_pauses_before_timing": true,
    "processed_audio_is_authoritative_timing_source": true,
    "max_final_voice_pause_seconds": 0.50,
    "default_long_pause_threshold_seconds": 0.45,
    "default_retained_pause_seconds": 0.12
  },
  "video_pacing": {
    "preferred_image_hold_seconds": "3-6",
    "max_image_hold_seconds": 7.0,
    "split_long_speech_beats_into_unique_images": true,
    "do_not_stretch_to_exact_runtime": true,
    "duplicate_image_reuse_allowed": false,
    "max_consecutive_isolated_object_frames": 2,
    "require_process_or_relationship_frame_after_isolated_run": true,
    "important_mechanism_frames_may_add_one_supporting_detail": true,
    "avoid_reusing_same_overview_composition": true,
    "minimum_process_relationship_context_frame_share": 0.6,
    "adjacent_scene_visual_difference_rule": "change at least two of camera scale, spatial layout, main subject, process direction, background context, or visual type"
  },
  "presentation": {
    "full_frame_illustration_share_target": "85-90%",
    "selective_remotion_presentation_share_max": "10-15%",
    "keep_illustration_full_frame_by_default": true,
    "avoid_persistent_frames_or_side_panels": true,
    "avoid_powerpoint_dashboard_presenter_layout": true,
    "remotion_text_types": [
      "heading",
      "keyword",
      "callout"
    ],
    "preferred_overlay_words": "2-6",
    "two_minute_video_guideline": "2-3 chapter headings plus optional 1 key fact or summary",
    "chapter_heading_duration_seconds": "0.8-1.5",
    "chapter_heading_over_next_illustration_preferred": true,
    "biology_labels_remain_in_flow": true
  },
  "remotion": {
    "purpose": "timing-motion-audio-transitions-selective-presentation",
    "text_strategy": "SELECTIVE_HEADINGS_KEYFACTS_SUMMARY_ONLY",
    "overlay_plan": "03_pipeline/overlay-plan.json",
    "max_words_per_overlay": 6,
    "full_voiceover_sentences_forbidden": true,
    "allowed_visual_motion": [
      "static",
      "slow-push-in",
      "slow-pull-out",
      "pan-left",
      "pan-right"
    ]
  },
  "topic_memory": "THEMEN-GEHIRN.md"
}
