{"status":"READY","video_id":"002-zucker-im-koerper","items":[{"id":"S01","voiceover_text":"Ein süßer Snack schmeckt schnell harmlos, aber im Körper beginnt sofort eine Reise.","function":"hook","learning_goal":"","claim_ids":[],"scale_level":"","new_image_required":true,"image_asset_id":"Bild_01","visual_type":"cover","visible_change":"","scene_difference":"","labels":[],"misconception_to_avoid":""},{"id":"S02","voiceover_text":"Schon beim Kauen wird die Nahrung zerkleinert und mit Speichel vermischt.","function":"explain","learning_goal":"","claim_ids":[],"scale_level":"","new_image_required":true,"image_asset_id":"Bild_02","visual_type":"explainer","visible_change":"","scene_difference":"","labels":["Mund"],"misconception_to_avoid":""},{"id":"S03","voiceover_text":"Bei stärkehaltigen Lebensmitteln beginnt im Mund sogar schon die Kohlenhydratverdauung.","function":"explain","learning_goal":"","claim_ids":[],"scale_level":"","new_image_required":true,"image_asset_id":"Bild_03","visual_type":"explainer","visible_change":"","scene_difference":"","labels":["Kohlenhydrate"],"misconception_to_avoid":""},{"id":"S04","voiceover_text":"Danach gelangt der Nahrungsbrei durch die Speiseröhre in den Magen.","function":"explain","learning_goal":"","claim_ids":[],"scale_level":"","new_image_required":true,"image_asset_id":"Bild_04","visual_type":"explainer","visible_change":"","scene_difference":"","labels":["Speiseröhre"],"misconception_to_avoid":""},{"id":"S05","voiceover_text":"Der Magen mischt alles weiter, nimmt aber nur wenig Zucker direkt auf.","function":"explain","learning_goal":"","claim_ids":[],"scale_level":"","new_image_required":true,"image_asset_id":"Bild_05","visual_type":"explainer","visible_change":"","scene_difference":"","labels":["Magen"],"misconception_to_avoid":""},{"id":"S06","voiceover_text":"Der wichtigste Abschnitt für die Zuckeraufnahme kommt erst im Dünndarm.","function":"explain","learning_goal":"","claim_ids":[],"scale_level":"","new_image_required":true,"image_asset_id":"Bild_06","visual_type":"explainer","visible_change":"","scene_difference":"","labels":["Dünndarm"],"misconception_to_avoid":""},{"id":"S07","voiceover_text":"Dort zerlegen Enzyme viele Kohlenhydrate in kleine Zuckerbausteine.","function":"explain","learning_goal":"","claim_ids":[],"scale_level":"","new_image_required":true,"image_asset_id":"Bild_07","visual_type":"explainer","visible_change":"","scene_difference":"","labels":["Enzyme","Zuckerbausteine"],"misconception_to_avoid":""},{"id":"S08","voiceover_text":"Einer der wichtigsten Bausteine ist Glukose, also Traubenzucker.","function":"explain","learning_goal":"","claim_ids":[],"scale_level":"","new_image_required":true,"image_asset_id":"Bild_08","visual_type":"explainer","visible_change":"","scene_difference":"","labels":["Glukose"],"misconception_to_avoid":""},{"id":"S09","voiceover_text":"Die Darmwand besitzt winzige Zotten, die ihre Oberfläche stark vergrößern.","function":"explain","learning_goal":"","claim_ids":[],"scale_level":"","new_image_required":true,"image_asset_id":"Bild_09","visual_type":"explainer","visible_change":"","scene_difference":"","labels":["Darmzotten"],"misconception_to_avoid":""},{"id":"S10","voiceover_text":"Über diese Oberfläche gelangt Glukose aus dem Darm in die Blutbahn.","function":"explain","learning_goal":"","claim_ids":[],"scale_level":"","new_image_required":true,"image_asset_id":"Bild_10","visual_type":"explainer","visible_change":"","scene_difference":"","labels":["Glukose","Blut"],"misconception_to_avoid":""},{"id":"S11","voiceover_text":"Das zuckerreiche Blut fließt zuerst über die Pfortader zur Leber.","function":"explain","learning_goal":"","claim_ids":[],"scale_level":"","new_image_required":true,"image_asset_id":"Bild_11","visual_type":"explainer","visible_change":"","scene_difference":"","labels":["Pfortader","Leber"],"misconception_to_avoid":""},{"id":"S12","voiceover_text":"Die Leber ist dabei ein wichtiger Verteiler und Zwischenspeicher.","function":"explain","learning_goal":"","claim_ids":[],"scale_level":"","new_image_required":true,"image_asset_id":"Bild_12","visual_type":"explainer","visible_change":"","scene_difference":"","labels":["Leber"],"misconception_to_avoid":""},{"id":"S13","voiceover_text":"Steigt Glukose im Blut, registriert das auch die Bauchspeicheldrüse.","function":"explain","learning_goal":"","claim_ids":[],"scale_level":"","new_image_required":true,"image_asset_id":"Bild_13","visual_type":"explainer","visible_change":"","scene_difference":"","labels":["Bauchspeicheldrüse","Glukose"],"misconception_to_avoid":""},{"id":"S14","voiceover_text":"Bestimmte Zellen der Bauchspeicheldrüse geben daraufhin Insulin ins Blut ab.","function":"explain","learning_goal":"","claim_ids":[],"scale_level":"","new_image_required":true,"image_asset_id":"Bild_14","visual_type":"explainer","visible_change":"","scene_difference":"","labels":["Insulin"],"misconception_to_avoid":""},{"id":"S15","voiceover_text":"Insulin ist ein Signalstoff und verteilt selbst keinen Zucker.","function":"explain","learning_goal":"","claim_ids":[],"scale_level":"","new_image_required":true,"image_asset_id":"Bild_15","visual_type":"explainer","visible_change":"","scene_difference":"","labels":["Insulin"],"misconception_to_avoid":""},{"id":"S16","voiceover_text":"Es bindet an Rezeptoren und verändert, wie verschiedene Gewebe mit Glukose umgehen.","function":"explain","learning_goal":"","claim_ids":[],"scale_level":"","new_image_required":true,"image_asset_id":"Bild_16","visual_type":"explainer","visible_change":"","scene_difference":"","labels":["Insulin","Rezeptor"],"misconception_to_avoid":""},{"id":"S17","voiceover_text":"Besonders Muskel- und Fettzellen können dadurch mehr Glukose aus dem Blut aufnehmen.","function":"explain","learning_goal":"","claim_ids":[],"scale_level":"","new_image_required":true,"image_asset_id":"Bild_17","visual_type":"explainer","visible_change":"","scene_difference":"","labels":["Glukose","Muskelzelle"],"misconception_to_avoid":""},{"id":"S18","voiceover_text":"Die Glukose passiert die Zellmembran über spezielle Transportproteine.","function":"explain","learning_goal":"","claim_ids":[],"scale_level":"","new_image_required":true,"image_asset_id":"Bild_18","visual_type":"explainer","visible_change":"","scene_difference":"","labels":["Glukose","Transportprotein"],"misconception_to_avoid":""},{"id":"S19","voiceover_text":"Im Inneren der Zelle beginnt dann der eigentliche Energiegewinn.","function":"explain","learning_goal":"","claim_ids":[],"scale_level":"","new_image_required":true,"image_asset_id":"Bild_19","visual_type":"explainer","visible_change":"","scene_difference":"","labels":["Zelle"],"misconception_to_avoid":""},{"id":"S20","voiceover_text":"Glukose wird zunächst in mehreren Schritten teilweise abgebaut.","function":"explain","learning_goal":"","claim_ids":[],"scale_level":"","new_image_required":true,"image_asset_id":"Bild_20","visual_type":"explainer","visible_change":"","scene_difference":"","labels":["Glukose"],"misconception_to_avoid":""},{"id":"S21","voiceover_text":"Ein Teil der dabei entstehenden Stoffe gelangt weiter in die Mitochondrien.","function":"explain","learning_goal":"","claim_ids":[],"scale_level":"","new_image_required":true,"image_asset_id":"Bild_21","visual_type":"explainer","visible_change":"","scene_difference":"","labels":["Mitochondrium"],"misconception_to_avoid":""},{"id":"S22","voiceover_text":"Dort kann die Zelle mit Sauerstoff besonders effizient ATP herstellen.","function":"explain","learning_goal":"","claim_ids":[],"scale_level":"","new_image_required":true,"image_asset_id":"Bild_22","visual_type":"explainer","visible_change":"","scene_difference":"","labels":["ATP","Mitochondrium"],"misconception_to_avoid":""},{"id":"S23","voiceover_text":"ATP ist eine direkt nutzbare Energieform für viele Zellprozesse.","function":"explain","learning_goal":"","claim_ids":[],"scale_level":"","new_image_required":true,"image_asset_id":"Bild_23","visual_type":"explainer","visible_change":"","scene_difference":"","labels":["ATP"],"misconception_to_avoid":""},{"id":"S24","voiceover_text":"Muskelzellen brauchen davon besonders viel, wenn sie sich zusammenziehen.","function":"explain","learning_goal":"","claim_ids":[],"scale_level":"","new_image_required":true,"image_asset_id":"Bild_24","visual_type":"explainer","visible_change":"","scene_difference":"","labels":["Muskelzelle","ATP"],"misconception_to_avoid":""},{"id":"S25","voiceover_text":"Aber nicht jede Glukose muss sofort zur Energiegewinnung verwendet werden.","function":"explain","learning_goal":"","claim_ids":[],"scale_level":"","new_image_required":true,"image_asset_id":"Bild_25","visual_type":"explainer","visible_change":"","scene_difference":"","labels":["Glukose"],"misconception_to_avoid":""},{"id":"S26","voiceover_text":"Muskel und Leber können einen Teil als Glykogen speichern.","function":"explain","learning_goal":"","claim_ids":[],"scale_level":"","new_image_required":true,"image_asset_id":"Bild_26","visual_type":"explainer","visible_change":"","scene_difference":"","labels":["Glykogen","Leber"],"misconception_to_avoid":""},{"id":"S27","voiceover_text":"Glykogen ist vereinfacht gesagt ein schnell verfügbarer Glukosespeicher.","function":"explain","learning_goal":"","claim_ids":[],"scale_level":"","new_image_required":true,"image_asset_id":"Bild_27","visual_type":"explainer","visible_change":"","scene_difference":"","labels":["Glykogen"],"misconception_to_avoid":""},{"id":"S28","voiceover_text":"Wenn die Speicher gut gefüllt sind, kann überschüssige Energie weiterverarbeitet werden.","function":"explain","learning_goal":"","claim_ids":[],"scale_level":"","new_image_required":true,"image_asset_id":"Bild_28","visual_type":"explainer","visible_change":"","scene_difference":"","labels":["Speicher"],"misconception_to_avoid":""},{"id":"S29","voiceover_text":"Bei längerem Energieüberschuss kann daraus auch Körperfett aufgebaut werden.","function":"explain","learning_goal":"","claim_ids":[],"scale_level":"","new_image_required":true,"image_asset_id":"Bild_29","visual_type":"explainer","visible_change":"","scene_difference":"","labels":["Fettzelle"],"misconception_to_avoid":""},{"id":"S30","voiceover_text":"Sinkt der Blutzucker zwischen den Mahlzeiten, verändert sich die Hormonlage wieder.","function":"explain","learning_goal":"","claim_ids":[],"scale_level":"","new_image_required":true,"image_asset_id":"Bild_30","visual_type":"explainer","visible_change":"","scene_difference":"","labels":["Blutzucker"],"misconception_to_avoid":""},{"id":"S31","voiceover_text":"Dann spielt unter anderem das Hormon Glukagon eine wichtige Rolle.","function":"explain","learning_goal":"","claim_ids":[],"scale_level":"","new_image_required":true,"image_asset_id":"Bild_31","visual_type":"explainer","visible_change":"","scene_difference":"","labels":["Glukagon"],"misconception_to_avoid":""},{"id":"S32","voiceover_text":"Es signalisiert der Leber, gespeicherte Glukose wieder verfügbar zu machen.","function":"explain","learning_goal":"","claim_ids":[],"scale_level":"","new_image_required":true,"image_asset_id":"Bild_32","visual_type":"explainer","visible_change":"","scene_difference":"","labels":["Glukagon","Leber"],"misconception_to_avoid":""},{"id":"S33","voiceover_text":"So hilft der Körper, den Blutzucker zwischen Mahlzeiten stabil zu halten.","function":"explain","learning_goal":"","claim_ids":[],"scale_level":"","new_image_required":true,"image_asset_id":"Bild_33","visual_type":"explainer","visible_change":"","scene_difference":"","labels":["Blutzucker"],"misconception_to_avoid":""},{"id":"S34","voiceover_text":"Zucker wird also nicht einfach nur verbrannt oder direkt als Fett gespeichert.","function":"explain","learning_goal":"","claim_ids":[],"scale_level":"","new_image_required":true,"image_asset_id":"Bild_34","visual_type":"explainer","visible_change":"","scene_difference":"","labels":[],"misconception_to_avoid":""},{"id":"S35","voiceover_text":"Er wird verdaut, aufgenommen, verteilt, genutzt, gespeichert und je nach Bedarf wieder freigesetzt.","function":"explain","learning_goal":"","claim_ids":[],"scale_level":"","new_image_required":true,"image_asset_id":"Bild_35","visual_type":"explainer","visible_change":"","scene_difference":"","labels":["Darm","Blut","Zelle"],"misconception_to_avoid":""}]}